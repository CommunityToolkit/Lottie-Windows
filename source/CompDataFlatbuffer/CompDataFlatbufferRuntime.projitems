<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <CompDataFlatbufferRuntimeImported>true</CompDataFlatbufferRuntimeImported>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>CompDataFlatbuffer</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)FlatBufferFormatException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Format.cs" />
    <!-- Generated by build/RegenerateFlatbuffers.ps1 from source/LottieFlatbuffer/lottie_comp.fbs.
         Checked in so that contributors do not need flatc installed. -->
    <Compile Include="$(MSBuildThisFileDirectory)Generated\lottie_comp_generated.cs" />
  </ItemGroup>
</Project>
