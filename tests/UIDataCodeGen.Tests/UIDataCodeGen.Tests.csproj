<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the code generators. Run with: dotnet test tests\UIDataCodeGen.Tests
    The tested sources are compiled into this assembly, so internal types can be tested directly.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\AnimatedVisualClassMembers.cs" Link="Sources\AnimatedVisualClassMembers.cs" />
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\AnimatedVisualField.cs" Link="Sources\AnimatedVisualField.cs" />
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\AnimatedVisualMemberUses.cs" Link="Sources\AnimatedVisualMemberUses.cs" />
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\AnimatedVisualMethod.cs" Link="Sources\AnimatedVisualMethod.cs" />
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\CodeBuilder.cs" Link="Sources\CodeBuilder.cs" />
    <Compile Include="..\..\source\UIDataCodeGen\CodeGen\CSharp\SharedAnimatedVisualMembers.cs" Link="Sources\SharedAnimatedVisualMembers.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

</Project>
